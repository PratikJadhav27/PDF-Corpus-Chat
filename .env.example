# Gemini API Key (required)
GOOGLE_API_KEY=your_api_key_here

# Optional: default collection name
DEFAULT_COLLECTION=default

# LLM model to use (e.g., gemini-2.5-flash, gemini-pro, etc.)
LLM_MODEL_NAME=gemini-2.5-flash

# Approximate cost per million tokens in USD (adjust per model/provider)
COST_PER_MILLION=0.15

# Observability: append JSONL traces to logs/rag_traces.jsonl (set false to disable)
OBSERVABILITY_ENABLED=true
# OBSERVABILITY_TRACES_PATH=logs/rag_traces.jsonl
